# Rendered to kitsu/kitsu.env by `make setup phd-server` (envsubst).
# Injected into the kitsu + kitsu-zou-* containers via env_file. DO NOT commit.
# Full Zou config reference: https://zou.cg-wire.com/configuration/

# Internal datastore hostnames = our service names
KV_HOST=kitsu-redis
DB_HOST=kitsu-db
EVENT_STREAM_HOST=kitsu-zou-event
INDEXER_HOST=kitsu-indexer

# Storage paths inside the containers
PREVIEW_FOLDER=/opt/zou/previews
TMP_DIR=/tmp/zou

# Async job queue (kitsu-zou-jobs RQ worker)
ENABLE_JOB_QUEUE=True

# Secrets / credentials (from Cumulus .env)
DB_PASSWORD=${KITSU_DB_PASSWORD}
INDEXER_KEY=${KITSU_INDEXER_KEY}
SECRET_KEY=${KITSU_SECRET_KEY}

# User cap
USER_LIMIT=200

# Public URL (used in password-reset / invite links)
DOMAIN_NAME=kitsu.${BASE_DOMAIN}
DOMAIN_PROTOCOL=https

# Mail via Resend. Leave KITSU_SMTP_PASSWORD empty in .env until Resend issues
# a key; Kitsu runs fine and just won't send mail. Verify these key names
# against https://zou.cg-wire.com/configuration/ before relying on mail.
MAIL_ENABLED=True
MAIL_SERVER=${KITSU_SMTP_HOST}
MAIL_PORT=${KITSU_SMTP_PORT}
MAIL_USERNAME=${KITSU_SMTP_USER}
MAIL_PASSWORD=${KITSU_SMTP_PASSWORD}
MAIL_USE_TLS=True
MAIL_DEFAULT_SENDER=${KITSU_MAIL_FROM}
