# ================================================
# ---- general ----
# ================================================

# Your domain name
BASE_DOMAIN=parkerhdavis.com

# Email for Let's Encrypt certificate registration
ACME_EMAIL=admin@parkerhdavis.com

# ================================================
# ---- droplet ----
# ================================================

# Pangolin server secret (min 32 chars, used for encryption)
# Generate with: openssl rand -hex 32
SERVER_SECRET=changeme

# Crowdsec Secret
# Generate with: openssl rand -hex 32
CROWDSEC_LAPI_KEY=changeme

# ================================================
# ---- phd-beelink ----
# ================================================

# Newt credentials (from Pangolin dashboard)
BEELINK_SITE_ID=changeme
BEELINK_SITE_SECRET=changeme

# Gokapi File Dropper
GOKAPI_DATA_PATH=/mnt/vault-2/Gokapi
GOKAPI_TZ=UTC

# Immich Photo Server
IMMICH_DB_PASSWORD=changeme
IMMICH_DB_USERNAME=postgres
IMMICH_DB_DATABASE_NAME=immich
IMMICH_REDIS_PASSWORD=changeme
IMMICH_LIBRARY_PATH=/mnt/vault-1/immich/library
IMMICH_DB_PATH=/mnt/vault-1/immich/postgres

# Jellyfin Media Server
JELLYFIN_MEDIA_PATH=/mnt/vault-2/Jellyfin

# Jellyfin Transcoding (Ofelia)
PROXY_TZ=America/Denver
PROXY_STATE_PATH=/mnt/vault-2/Archival/proxy-logs
PROXY_MAX_FILES=2
PROXY_CRF=18

# Ollama Cloud API key for Open WebUI (from https://ollama.com/settings/keys)
# Leave empty to use no OpenAI-compatible backend.
OLLAMA_CLOUD_API_KEY=

# ================================================
# ---- phd-tower ----
# ================================================

# Newt credentials (from Pangolin dashboard)
TOWER_SITE_ID=changeme
TOWER_SITE_SECRET=changeme

# ================================================
# ---- phd-razer ----
# ================================================

# Newt credentials (from Pangolin dashboard)
RAZER_SITE_ID=changeme
RAZER_SITE_SECRET=changeme
