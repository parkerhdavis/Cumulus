# ---- General ----

# Your domain name
BASE_DOMAIN=example.com

# Email for Let's Encrypt certificate registration
ACME_EMAIL=you@example.com

# ---- Droplet (Pangolin) ----

# Pangolin server secret (min 32 chars, used for encryption)
# Generate with: openssl rand -hex 32
SERVER_SECRET=changeme

# ---- Droplet (CrowdSec) ----

# Shared secret between CrowdSec's Local API and the Traefik bouncer plugin.
# Registered as the "traefik" bouncer at startup (BOUNCER_KEY_traefik) and used
# as the plugin's crowdsecLapiKey. Any opaque string works.
# Generate with: openssl rand -hex 32
CROWDSEC_LAPI_KEY=changeme

# ---- phd-server (Newt) ----

# Newt credentials (from Pangolin dashboard)
NEWT_ID=changeme
NEWT_SECRET=changeme

# ---- phd-server (Jellyfin) ---- 

# Path to Jellyfin media library on the host
JELLYFIN_MEDIA_PATH=/path/to/media

# ---- phd-server (Tier-3 proxy transcoding via Ofelia) ----
# Nightly job that encodes 1080p H.264 proxies of 4K sources in the Jellyfin
# library. See media-pipeline/transcode-proxies.sh and ofelia/config.ini.template.
PROXY_TZ=America/Denver
# Host dir for the proxy log + lock (created by `make setup phd-server`).
PROXY_STATE_PATH=/path/to/media/../Archival/proxy-logs
# Max source files encoded per nightly run (archival encodes are slow).
PROXY_MAX_FILES=2
# libx264 CRF for the proxy (18 = conservative/archival; 20 is smaller, still good).
PROXY_CRF=18

# ---- phd-server (Immich) ----

# Postgres password for Immich (A-Za-z0-9 only)
# Generate with: openssl rand -hex 16
IMMICH_DB_PASSWORD=changeme
IMMICH_DB_USERNAME=postgres
IMMICH_DB_DATABASE_NAME=immich

# Redis password for Immich (A-Za-z0-9 only)
# Generate with: openssl rand -hex 16
IMMICH_REDIS_PASSWORD=changeme

# Path to Immich photo library on the host
IMMICH_LIBRARY_PATH=/path/to/immich/library

# Path to Immich Postgres data on the host
IMMICH_DB_PATH=/path/to/immich/postgres

# ---- phd-server (Websidian) ----

# Path to your Obsidian vault on the host
VAULT_PATH=/path/to/obsidian/vault

# Folders to hide from the web viewer
WEBSIDIAN_HIDE_FOLDERS=.obsidian,.git,.trash,.stversions,.stfolder,.claude,.venv

# Container internal port and host-mapped port
WEBSIDIAN_PORT=3000
WEBSIDIAN_HOST_PORT=3200

# ---- phd-server (Open WebUI + Ollama) ----

# Path to Ollama model data on the host
OLLAMA_DATA_PATH=/path/to/ollama/data

# DGX Spark mDNS hostname (leave empty if not using a Spark)
# The Makefile resolves this to an IP at startup so containers can reach it
SPARK_HOSTNAME=

# Ollama URLs for Open WebUI (semicolon-separated)
# If SPARK_HOSTNAME is set, the Spark is appended automatically on startup
OPEN_WEBUI_OLLAMA_URLS=http://ollama:11434

# Ollama Cloud API key (from https://ollama.com/settings/keys)
OLLAMA_CLOUD_API_KEY=

# ---- phd-server (Gokapi) ----

# Path to Gokapi's uploaded-file storage on the host. Drop uploads can grow, so
# keep this on a capacity drive (like Jellyfin media / the Immich library). The
# small config + SQLite DB use a named volume instead, so only this is a path.
GOKAPI_DATA_PATH=/path/to/gokapi/data

# Timezone for Gokapi log timestamps (e.g. America/Denver). Defaults to UTC.
GOKAPI_TZ=UTC

# Optional: only needed if Gokapi logs the Docker bridge gateway instead of the
# real client IP. Set to the proxy's source address/range (find the subnet with
# `docker network inspect cumulus_default`) and add
# `- GOKAPI_TRUSTED_PROXIES=${GOKAPI_TRUSTED_PROXIES}` to the gokapi service.
#GOKAPI_TRUSTED_PROXIES=
