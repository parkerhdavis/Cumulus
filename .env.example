# ================================================
# ---- general ----
# ================================================

# Your domain name
BASE_DOMAIN=parkerhdavis.com

# Email for Let's Encrypt certificate registration
ACME_EMAIL=admin@parkerhdavis.com

# Headless Obsidian Sync (https://obsidian.md/help/sync/headless).
# OBSIDIAN_EMAIL/OBSIDIAN_PASSWORD are only used to obtain a login token,
# which persists in the obsidian-headless state volume afterwards. If the
# account uses 2FA, log in once interactively instead:
#   docker compose -f docker-compose.phd-razer.yml run --rm --entrypoint sh obsidian-personal
#   ob login --email <email>
OBSIDIAN_EMAIL=phd@parkerhdavis.com
OBSIDIAN_PASSWORD='KrOH#RXGKR*eGep!M4x7'

# End-to-end encryption password shared by all vaults. It must already match
# the password of any vault synced from the desktop app; the entrypoint uses
# it when creating remote vaults that don't exist yet and when linking to
# existing e2ee remotes.
OBSIDIAN_E2EE_PASSWORD='3pe7F2#QBrDVj3q@ihd7&gxF'

# Home root the vault directories live under on the phd-* hosts. Each compose
# file binds the org wikis from ${OBSIDIAN_VAULTS_BASE}/{Org}/-wiki (all
# identically-named folders, disambiguated by the vault label inside the
# container), and Personal directly under it.
OBSIDIAN_VAULTS_BASE=/home/parker

# UID/GID the sync containers run as and synced files are owned by (run
# `id -u` and `id -g` in your shell; defaults to 1000/1000)
#OBSIDIAN_UID=1000
#OBSIDIAN_GID=1000

# Optional: an existing auth token (ob honors OBSIDIAN_AUTH_TOKEN directly;
# unnecessary if OBSIDIAN_EMAIL/OBSIDIAN_PASSWORD work)
#OBSIDIAN_AUTH_TOKEN=

# ================================================
# ---- droplet ----
# ================================================

# Pangolin server secret (min 32 chars, used for encryption)
# Generate with: openssl rand -hex 32
SERVER_SECRET=changeme

# Crowdsec Secret
# Generate with: openssl rand -hex 32
CROWDSEC_LAPI_KEY=changeme

# ================================================
# ---- phd-beelink ----
# ================================================

# Pangolin site credentials (from Pangolin dashboard)
BEELINK_SITE_ID=changeme
BEELINK_SITE_SECRET=changeme

# Gokapi File Dropper
GOKAPI_DATA_PATH=/mnt/vault-2/Gokapi
GOKAPI_TZ=UTC

# Immich Photo Server
IMMICH_DB_PASSWORD=changeme
IMMICH_DB_USERNAME=postgres
IMMICH_DB_DATABASE_NAME=immich
IMMICH_REDIS_PASSWORD=changeme
IMMICH_LIBRARY_PATH=/mnt/vault-1/immich/library
IMMICH_DB_PATH=/mnt/vault-1/immich/postgres

# Jellyfin Media Server
JELLYFIN_MEDIA_PATH=/mnt/vault-2/Jellyfin

# Jellyfin Transcoding (Ofelia)
PROXY_TZ=America/Denver
PROXY_STATE_PATH=/mnt/vault-2/Archival/proxy-logs
PROXY_MAX_FILES=2
PROXY_CRF=18

# ================================================
# ---- phd-tower ----
# ================================================

# Pangolin site credentials (from Pangolin dashboard)
TOWER_SITE_ID=changeme
TOWER_SITE_SECRET=changeme

# Forgejo forge (docker-compose.phd-tower.yml). The data path is an absolute
# capacity location on the tower for git repositories and LFS objects — they
# accumulate, like media on the beelink — and must be owned by uid/gid 1000 or
# the container won't start. The four secrets must all exist before
# `make up phd-tower`: the headless install (INSTALL_LOCK) skips the web wizard
# that would otherwise generate them. Keep comments off the value lines: a
# `KEY=value # note` inline form parses as an empty value, and regenerating
# these mid-life is a rotation (safe only while the forge is empty). Generate:
#   FORGEJO_DB_PASSWORD, FORGEJO_SECRET_KEY: openssl rand -hex 32
#   FORGEJO_INTERNAL_TOKEN: openssl rand -hex 43
#   FORGEJO_LFS_JWT_SECRET: openssl rand -base64 32  (base64 32-byte value)
FORGEJO_DATA_PATH=changeme
FORGEJO_DB_PASSWORD=changeme
FORGEJO_SECRET_KEY=changeme
FORGEJO_INTERNAL_TOKEN=changeme
FORGEJO_LFS_JWT_SECRET=changeme

# forge-backup (stub: dormant behind the `backups` compose profile until the
# first run is wanted after the project migration; see phd-tower Backup
# Design). Fill when plugging in, then `docker compose -f
# docker-compose.phd-tower.yml --profile backups up -d backup` after one
# manual `restic init`. The passphrase is the only key to the backup — losing
# it loses the backup, so it must live in a password manager; the .env
# overwrite incident is why these lines carry no inline comments.
#BACKUP_REPOSITORY=s3:https://<region>.digitaloceanspaces.com/<bucket>
#BACKUP_PASSWORD=
#BACKUP_S3_KEY=
#BACKUP_S3_SECRET=

# ================================================
# ---- phd-razer ----
# ================================================

# Pangolin site credentials (from Pangolin dashboard)
RAZER_SITE_ID=changeme
RAZER_SITE_SECRET=changeme
