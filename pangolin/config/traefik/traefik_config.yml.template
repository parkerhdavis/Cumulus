api:
  insecure: false
  dashboard: false

providers:
  http:
    endpoint: "http://pangolin:3001/api/v1/traefik-config"
    pollInterval: "5s"
  file:
    filename: "/etc/traefik/dynamic_config.yml"

experimental:
  plugins:
    badger:
      moduleName: "github.com/fosrl/badger"
      version: "v1.3.1"
    bouncer:
      moduleName: "github.com/maxlerebourg/crowdsec-bouncer-traefik-plugin"
      version: "v1.6.0"

log:
  level: "INFO"
  format: "common"
  maxSize: 100
  maxBackups: 3
  maxAge: 3
  compress: true

# JSON access log for CrowdSec to parse. Headers default to drop (so
# Authorization/Cookie are never written); User-Agent + forwarded-IP headers are
# kept because CrowdSec's traefik scenarios use them. CrowdSec reads this file
# read-only via ./pangolin/config/crowdsec/acquis.d/traefik.yaml.
accessLog:
  filePath: "/var/log/traefik/access.log"
  format: json
  fields:
    headers:
      defaultMode: drop
      names:
        User-Agent: keep
        X-Forwarded-For: keep
        X-Real-Ip: keep

certificatesResolvers:
  letsencrypt:
    acme:
      httpChallenge:
        entryPoint: web
      email: "${ACME_EMAIL}"
      storage: "/letsencrypt/acme.json"
      caServer: "https://acme-v02.api.letsencrypt.org/directory"

entryPoints:
  tcp-1666:
    address: ":1666/tcp"
  web:
    address: ":80"
  websecure:
    address: ":443"
    transport:
      respondingTimeouts:
        readTimeout: "30m"
    http:
      # Applies the CrowdSec bouncer to every HTTPS router — i.e. every Pangolin
      # resource plus the Pangolin dashboard — without editing Pangolin's
      # dynamically-generated per-resource config. Runs before each router's own
      # badger middleware, so banned IPs are dropped before auth. The `web` (:80)
      # entryPoint is intentionally left unguarded so ACME HTTP-01 keeps working.
      middlewares:
        - crowdsec@file
      tls:
        certResolver: "letsencrypt"
      encodedCharacters:
        allowEncodedSlash: true
        allowEncodedQuestionMark: true

serversTransport:
  insecureSkipVerify: true

ping:
  entryPoint: "web"
